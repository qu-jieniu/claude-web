#!/usr/bin/env bash
# claude-jsonl-view — open the active claude session's JSONL in `less +F`.
#
# Bound to Ctrl-A j inside every claude-* screen. Resolves the JSONL via
# `claude-status --jsonl $STY-suffix` (so the same lookup logic that powers
# the status bar finds the right file), then execs less in follow mode so
# the view stays live as Claude appends new turns.
#
# `q` exits less; `F` re-enters follow mode after Ctrl-C; `/` searches.
set -e

sname="${STY##*.}"
if [ -z "$sname" ]; then
    printf 'error: not inside a screen session (STY unset)\n' >&2
    read -n1 -s -r -p '[any key to close]'
    exit 1
fi

jsonl=$("$HOME/claude-web/claude-status" --jsonl "$sname" 2>/dev/null) || true

if [ -z "$jsonl" ] || [ ! -f "$jsonl" ]; then
    printf 'no JSONL found for screen %s\n' "$sname" >&2
    printf '(plain shells and freshly-started sessions have nothing to view)\n' >&2
    read -n1 -s -r -p '[any key to close]'
    exit 1
fi

# Pipe the formatted JSONL into less. The pretty-printer dumps existing
# content and exits at EOF, so less shows (END) at the bottom and behaves
# like a normal pager — no follow mode, no "Waiting for data" surprise.
# +G jumps to the end on open so the most-recent turn is visible; user
# scrolls up for older content. To see new turns appended after opening,
# close (q) and re-press Ctrl-A j.
"$HOME/claude-web/claude-jsonl-pretty" "$jsonl" | less -R +G
