{
	admin off
	auto_https off
	persist_config off
}

:{$OMP_HTTP_PORT} {
	bind {$OMP_BIND_ADDRESS}
	header X-Content-Type-Options nosniff
	header Cache-Control no-store
	handle /upload* {
		reverse_proxy 127.0.0.1:{$OMP_UPLOAD_PORT}
	}
	handle /presence* {
		reverse_proxy 127.0.0.1:{$OMP_UPLOAD_PORT}
	}
	handle /history* {
		reverse_proxy 127.0.0.1:{$OMP_UPLOAD_PORT}
	}
	handle /t/* {
		reverse_proxy 127.0.0.1:{$OMP_TERMINAL_PORT}
	}
	handle {
		root * {$OMP_WEB_ROOT}/web
		file_server
	}
}
