#!/usr/bin/env python3
"""
Single-line status for a claude-web screen session.

Usage:  claude-status <screen-name>

Output (no trailing newline):
    ctx 48k/190k (25%) │ 5h 23% (⏱ 1h42m)

Designed to be invoked by screen's `backtick` directive every ~30s, so
must be cheap. The OAuth-endpoint result is cached at /tmp/claude-status-
oauth-cache.json with a 5-minute TTL; the network call only happens on
cache miss. Token refresh handled automatically when the access token
is near expiry.

Returns "—" on missing inputs rather than failing — the bar should
degrade gracefully if a session has no JSONL yet, the cache is stale,
or credentials are missing.
"""
from __future__ import annotations
import json
import os
import re
import subprocess
import sys
import time
import urllib.request
import urllib.error
from datetime import datetime, timezone

HOME = os.path.expanduser("~")
STATE_DIR = f"{HOME}/claude-web/state/sessions"
PROJECTS_DIR = f"{HOME}/.claude/projects"
CRED_PATH = f"{HOME}/.claude/.credentials.json"
CACHE_PATH = "/tmp/claude-status-oauth-cache.json"
CACHE_TTL = 300

# Private endpoint that Claude Code itself uses to surface the 5h/weekly
# caps in its UI. Auth is the OAuth bearer token from .credentials.json.
# Undocumented; requires the anthropic-beta header. May break — caller
# falls back to "5h ?" if it does.
OAUTH_USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
OAUTH_TOKEN_URL = "https://console.anthropic.com/v1/oauth/token"
OAUTH_CLIENT_ID = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"
OAUTH_BETA = "oauth-2025-04-20"


def humanize_n(n: int) -> str:
    if n >= 1_000_000:
        s = f"{n/1_000_000:.1f}M"
        return s.replace(".0M", "M")
    if n >= 1000:
        return f"{n/1000:.0f}k"
    return str(n)


def humanize_eta(seconds: int) -> str:
    if seconds < 0:
        return "now"
    h, rem = divmod(seconds, 3600)
    m = rem // 60
    if h:
        return f"{h}h{m:02d}m"
    return f"{m}m"


def project_dir_for(cwd: str) -> str:
    return f"{PROJECTS_DIR}/" + cwd.replace("/", "-").replace(".", "-")


def read_env(name: str) -> dict | None:
    path = f"{STATE_DIR}/{name}.env"
    if not os.path.exists(path):
        return None
    out: dict[str, str] = {}
    for line in open(path):
        line = line.strip()
        if "=" in line:
            k, v = line.split("=", 1)
            out[k] = v.strip("'\"")
    return out


def newest_jsonl(cwd: str) -> str | None:
    pdir = project_dir_for(cwd)
    if not os.path.isdir(pdir):
        return None
    files = [f"{pdir}/{f}" for f in os.listdir(pdir) if f.endswith(".jsonl")]
    return max(files, key=os.path.getmtime) if files else None


def screen_pid(sname: str) -> int | None:
    try:
        out = subprocess.check_output(["screen", "-ls"], text=True, stderr=subprocess.DEVNULL)
    except Exception:
        return None
    for line in out.splitlines():
        m = re.match(r"\s*(\d+)\.(\S+)", line)
        if m and m.group(2) == sname:
            return int(m.group(1))
    return None


def find_claude_descendant(root_pid: int) -> int | None:
    """BFS down /proc looking for a 'claude' executable in the descendants
    of root_pid. Walks process tree by PPid in /proc/*/stat."""
    children: dict[int, list[int]] = {}
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            with open(f"/proc/{entry}/stat") as fp:
                stat_line = fp.read()
            ppid = int(stat_line.rsplit(")", 1)[1].split()[1])
        except Exception:
            continue
        children.setdefault(ppid, []).append(int(entry))
    queue = [root_pid]
    seen: set[int] = set()
    while queue:
        p = queue.pop(0)
        if p in seen:
            continue
        seen.add(p)
        for c in children.get(p, []):
            try:
                comm = open(f"/proc/{c}/comm").read().strip()
            except Exception:
                comm = ""
            if comm == "claude":
                return c
            queue.append(c)
    return None


HISTORY_PATH = f"{HOME}/.claude/history.jsonl"


def proc_cwd(pid: int) -> str | None:
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except Exception:
        return None


def latest_session_for_cwd(cwd: str) -> str | None:
    """Walk ~/.claude/history.jsonl and return the most-recent sessionId
    whose project field matches cwd. history.jsonl is append-only — every
    user message writes one line — so the last matching entry is the
    currently-active session for that cwd. Survives /clear (new sessionId
    appended) and /exit + restart."""
    if not os.path.exists(HISTORY_PATH):
        return None
    latest_sid: str | None = None
    latest_ts = -1
    try:
        with open(HISTORY_PATH) as fp:
            for line in fp:
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                if d.get("project") != cwd:
                    continue
                ts = d.get("timestamp", 0)
                if ts > latest_ts:
                    latest_ts = ts
                    latest_sid = d.get("sessionId")
    except Exception:
        return None
    return latest_sid


def first_user_msg(jsonl_path: str) -> str:
    """Read the first user message body of a JSONL, for content-sniffing.
    Returns '' if it can't be parsed or the file has no user messages."""
    try:
        with open(jsonl_path) as fp:
            for line in fp:
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                if d.get("type") not in ("user", "human"):
                    continue
                msg = d.get("message", d)
                c = msg.get("content", "")
                if isinstance(c, list):
                    c = " ".join(
                        x.get("text", "") for x in c if isinstance(x, dict)
                    )
                if isinstance(c, str):
                    return c[:200]
                return ""
    except Exception:
        pass
    return ""


def discord_router_jsonl(cwd: str) -> str | None:
    """For sessions like claude-discord that don't write to history.jsonl
    (their user messages come in via the Discord plugin's MCP server, not
    the terminal), find the Discord-router JSONL by content-sniffing.
    Discord sessions' first user message starts with <channel source=
    "plugin:discord:discord" ...>. Pick the most recently modified
    matching file in the project dir."""
    pdir = project_dir_for(cwd)
    if not os.path.isdir(pdir):
        return None
    candidates: list[tuple[float, str]] = []
    for f in os.listdir(pdir):
        if not f.endswith(".jsonl"):
            continue
        path = f"{pdir}/{f}"
        first = first_user_msg(path)
        if 'source="plugin:discord:discord"' in first:
            try:
                candidates.append((os.path.getmtime(path), path))
            except Exception:
                pass
    if not candidates:
        return None
    return max(candidates)[1]


def session_jsonl(name: str | None, env: dict | None) -> str | None:
    """Resolve the live JSONL for this session.

    Order of preference:
    1. claude-discord special-case: sniff for the Discord-marked JSONL
       in the project dir and pick the newest. Discord messages don't
       write to history.jsonl, so the normal lookup would mis-identify.
    2. Inspect the claude process inside this screen: read its cwd from
       /proc and look up the latest sessionId for that cwd in
       ~/.claude/history.jsonl. Tracks /clear and /exit + restart
       correctly because history.jsonl gets a new entry on every user
       message and we always pick the most recent.
    3. Fall back to .env CWD + history.jsonl lookup or .env UUID pin.
    4. Newest JSONL in the project dir — last resort."""
    cwd: str | None = None
    if name:
        sp = screen_pid(name)
        if sp is not None:
            cp = find_claude_descendant(sp)
            if cp is not None:
                cwd = proc_cwd(cp)
    if not cwd and env:
        cwd = env.get("CWD")
    if not cwd:
        return None
    if name == "claude-discord":
        d = discord_router_jsonl(cwd)
        if d:
            return d
    sid = latest_session_for_cwd(cwd)
    if sid:
        path = f"{project_dir_for(cwd)}/{sid}.jsonl"
        if os.path.exists(path):
            return path
    if env and env.get("UUID"):
        path = f"{project_dir_for(cwd)}/{env['UUID']}.jsonl"
        if os.path.exists(path):
            return path
    return newest_jsonl(cwd)


def parse_ctx(jsonl_path: str) -> tuple[int | None, int | None, str | None]:
    """Returns (latest_ctx, max_ctx_ever, model). Max is tracked across the
    whole JSONL so a session that's already crossed into 1M-context territory
    keeps reporting the right threshold even after Claude auto-compacts and
    drops the latest turn back below 200K. `latest_ctx` skips turns with
    zero total usage — those are interrupted/aborted turns or pure tool
    results that don't reflect actual context size, and using them would
    show `ctx 0/...` even on a heavily-loaded session."""
    last_ctx: int | None = None
    max_ctx = 0
    model: str | None = None

    def turn_ctx(u: dict) -> int:
        return (
            u.get("input_tokens", 0)
            + u.get("cache_creation_input_tokens", 0)
            + u.get("cache_read_input_tokens", 0)
        )

    try:
        with open(jsonl_path) as fp:
            for line in fp:
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                if d.get("type") != "assistant":
                    continue
                msg = d.get("message", {})
                u = msg.get("usage")
                if not u:
                    continue
                ctx = turn_ctx(u)
                if ctx > 0:
                    last_ctx = ctx
                if ctx > max_ctx:
                    max_ctx = ctx
                if msg.get("model"):
                    model = msg["model"]
    except Exception:
        return None, None, None
    if last_ctx is None:
        return None, None, None
    return last_ctx, max_ctx, model


def compact_threshold(max_ctx: int) -> int:
    """Auto-compact trigger ≈ 95% of the model's context window. The JSONL
    records only the bare model id ("claude-opus-4-7") — no signal whether
    [1m] mode is on — so we infer from the largest ctx ever observed in
    this session: any past turn over 200K means we're in 1M territory and
    the threshold should stay at 950K even when the current turn is small.
    A fresh 1M-mode session that hasn't crossed 200K yet will misreport
    until it does; there's no clean fix without the model id telling us."""
    return 950_000 if max_ctx > 200_000 else 190_000


def load_creds() -> dict:
    return json.load(open(CRED_PATH))["claudeAiOauth"]


def save_creds(updated: dict) -> None:
    full = json.load(open(CRED_PATH))
    full["claudeAiOauth"] = updated
    tmp = CRED_PATH + ".tmp"
    with open(tmp, "w") as fp:
        json.dump(full, fp, indent=2)
    os.chmod(tmp, 0o600)
    os.rename(tmp, CRED_PATH)


def refresh_oauth(creds: dict) -> dict:
    body = json.dumps({
        "grant_type": "refresh_token",
        "refresh_token": creds["refreshToken"],
        "client_id": OAUTH_CLIENT_ID,
    }).encode()
    req = urllib.request.Request(OAUTH_TOKEN_URL, data=body, method="POST")
    req.add_header("Content-Type", "application/json")
    with urllib.request.urlopen(req, timeout=10) as r:
        new = json.loads(r.read())
    creds["accessToken"] = new["access_token"]
    creds["refreshToken"] = new.get("refresh_token", creds["refreshToken"])
    creds["expiresAt"] = int(time.time() * 1000) + new.get("expires_in", 3600) * 1000
    save_creds(creds)
    return creds


def fetch_usage() -> dict:
    creds = load_creds()
    if creds.get("expiresAt", 0) / 1000 < time.time() + 60:
        try:
            creds = refresh_oauth(creds)
        except Exception:
            pass
    req = urllib.request.Request(OAUTH_USAGE_URL)
    req.add_header("Authorization", f"Bearer {creds['accessToken']}")
    req.add_header("anthropic-beta", OAUTH_BETA)
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.loads(r.read())


def cached_usage() -> dict | None:
    try:
        st = os.stat(CACHE_PATH)
        if time.time() - st.st_mtime < CACHE_TTL:
            return json.load(open(CACHE_PATH))
    except FileNotFoundError:
        pass
    try:
        data = fetch_usage()
        tmp = CACHE_PATH + ".tmp"
        with open(tmp, "w") as fp:
            json.dump(data, fp)
        os.rename(tmp, CACHE_PATH)
        return data
    except Exception:
        try:
            return json.load(open(CACHE_PATH))
        except Exception:
            return None


def parse_iso(s: str) -> datetime:
    return datetime.fromisoformat(s.replace("Z", "+00:00"))


def fmt_ctx(name: str | None) -> str | None:
    if not name:
        return None
    env = read_env(name)
    jsonl = session_jsonl(name, env)
    if not jsonl:
        return "ctx -"
    ctx, max_ctx, _model = parse_ctx(jsonl)
    if ctx is None:
        return "ctx ?"
    cap = compact_threshold(max_ctx or ctx)
    pct = round(ctx * 100 / cap)
    return f"ctx {humanize_n(ctx)}/{humanize_n(cap)} ({pct}%)"


def fmt_cap() -> str | None:
    usage = cached_usage()
    if not usage:
        return "5h ?"
    fh = usage.get("five_hour") or {}
    util = round(fh.get("utilization", 0))
    resets = fh.get("resets_at")
    if resets:
        try:
            secs = int((parse_iso(resets) - datetime.now(timezone.utc)).total_seconds())
            return f"5h {util}% (⏱ {humanize_eta(secs)})"
        except Exception:
            pass
    return f"5h {util}%"


def main() -> int:
    name = sys.argv[1] if len(sys.argv) > 1 else None
    parts = [p for p in (fmt_ctx(name), fmt_cap()) if p]
    sys.stdout.write(" │ ".join(parts) if parts else "—")
    return 0


if __name__ == "__main__":
    sys.exit(main())
