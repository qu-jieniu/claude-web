#!/usr/bin/env python3
"""claude-jsonl-pretty — stream a Claude Code JSONL as readable transcript.

Reads the file from start, formats each JSONL event as a human-readable
block, then tails forever for new lines as Claude appends them. Designed
to be piped into `less +F` so the user sees the same content they'd see
in the TUI without the raw JSON noise.

Usage: claude-jsonl-pretty <path>
"""
from __future__ import annotations
import json
import sys
import time
from datetime import datetime


def fmt_ts(ts: str) -> str:
    if not ts:
        return ""
    try:
        dt = datetime.fromisoformat(ts.replace("Z", "+00:00"))
        return dt.astimezone().strftime("%H:%M:%S")
    except Exception:
        return ""


def user_text(content) -> str:
    """User `message.content` can be a string or a list of typed blocks."""
    if isinstance(content, str):
        return content.rstrip()
    if not isinstance(content, list):
        return ""
    parts: list[str] = []
    for c in content:
        if not isinstance(c, dict):
            continue
        t = c.get("type")
        if t == "text":
            parts.append(c.get("text", ""))
        elif t == "tool_result":
            tc = c.get("content", "")
            if isinstance(tc, list):
                tc = "".join(
                    x.get("text", "") for x in tc if isinstance(x, dict)
                )
            tc = str(tc).rstrip()
            if len(tc) > 400:
                tc = tc[:400] + f"\n…(+{len(tc)-400} chars)"
            err = " [error]" if c.get("is_error") else ""
            parts.append(f"  ↳ tool_result{err}:\n{indent(tc)}")
        elif t == "image":
            parts.append("  [image]")
    return "\n".join(p for p in parts if p).rstrip()


def indent(s: str, n: int = 4) -> str:
    pad = " " * n
    return "\n".join(pad + ln for ln in s.splitlines())


def short(s: str, limit: int = 80) -> str:
    s = s.strip().replace("\n", " ⏎ ")
    return s if len(s) <= limit else s[: limit - 1] + "…"


def assistant_block(msg: dict) -> str:
    parts: list[str] = []
    for c in msg.get("content", []):
        if not isinstance(c, dict):
            continue
        t = c.get("type")
        if t == "text":
            txt = c.get("text", "").rstrip()
            if txt:
                parts.append(txt)
        elif t == "thinking":
            txt = c.get("thinking", "").rstrip()
            if txt:
                parts.append(f"  ⟪ thinking: {short(txt, 200)} ⟫")
        elif t == "tool_use":
            name = c.get("name", "?")
            inp = c.get("input") or {}
            hint = ""
            for key in (
                "description",
                "command",
                "file_path",
                "path",
                "query",
                "pattern",
                "prompt",
                "url",
                "skill",
            ):
                v = inp.get(key)
                if isinstance(v, str) and v.strip():
                    hint = short(v)
                    break
            parts.append(f"  → {name}({hint})" if hint else f"  → {name}()")
    return "\n\n".join(parts).rstrip()


def fmt(line: str) -> str | None:
    try:
        d = json.loads(line)
    except Exception:
        return None
    t = d.get("type")
    ts = fmt_ts(d.get("timestamp", ""))
    if t == "user":
        text = user_text(d.get("message", {}).get("content"))
        if not text:
            return None
        sep = "─" * 70
        return f"\n{sep}\n  YOU  {ts}\n{sep}\n{text}\n"
    if t == "assistant":
        body = assistant_block(d.get("message", {}))
        if not body:
            return None
        model = d.get("message", {}).get("model", "")
        sep = "═" * 70
        head = f"  CLAUDE  {ts}" + (f"  · {model}" if model else "")
        return f"\n{sep}\n{head}\n{sep}\n{body}\n"
    if t == "summary":
        sep = "·" * 70
        return f"\n{sep}\n  SUMMARY\n{sep}\n{d.get('summary', '').strip()}\n"
    return None


def main() -> int:
    if len(sys.argv) < 2:
        print("usage: claude-jsonl-pretty <path>", file=sys.stderr)
        return 1
    path = sys.argv[1]
    try:
        fp = open(path, encoding="utf-8", errors="replace")
    except OSError as e:
        print(f"cannot open {path}: {e}", file=sys.stderr)
        return 1
    try:
        while True:
            line = fp.readline()
            if line:
                out = fmt(line)
                if out:
                    sys.stdout.write(out)
                    sys.stdout.flush()
            else:
                time.sleep(0.5)
    except (BrokenPipeError, KeyboardInterrupt):
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
