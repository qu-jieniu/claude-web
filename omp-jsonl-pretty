#!/usr/bin/env python3
"""omp-jsonl-pretty — format an omp session JSONL as readable transcript.

Reads the file from start, formats each JSONL event as a human-readable
block, then exits at EOF. Designed to be piped into `less -R` so the
viewer behaves like a normal pager (scroll, search, (END) marker, q to
quit). To see new turns added after opening, close and re-open the view.

Usage: omp-jsonl-pretty <path>
"""
from __future__ import annotations
import json
import shutil
import sys
from datetime import datetime
import unicodedata


WIDTH = max(1, min(70, shutil.get_terminal_size().columns - 1))


def safe_text(text: str) -> str:
    """Never replay terminal controls stored in messages or tool output."""
    return "".join(
        c for c in text
        if c in "\n\t" or unicodedata.category(c) != "Cc"
    )


def fmt_ts(ts: str) -> str:
    if not ts:
        return ""
    try:
        dt = datetime.fromisoformat(ts.replace("Z", "+00:00"))
        return dt.astimezone().strftime("%H:%M:%S")
    except Exception:
        return ""


def indent(s: str, n: int = 4) -> str:
    pad = " " * n
    return "\n".join(pad + ln for ln in s.splitlines())


def short(s: str, limit: int = 80) -> str:
    s = s.strip().replace("\n", " ⏎ ")
    return s if len(s) <= limit else s[: limit - 1] + "…"


def text_of(content) -> str:
    """Concatenate the text blocks of a message content list."""
    if isinstance(content, str):
        return content.rstrip()
    if not isinstance(content, list):
        return ""
    parts: list[str] = []
    for c in content:
        if isinstance(c, dict) and c.get("type") == "text" and isinstance(c.get("text"), str):
            parts.append(c.get("text", ""))
    return "\n".join(p for p in parts if p).rstrip()


def assistant_block(msg: dict) -> str:
    content = msg.get("content")
    if isinstance(content, str):
        return content.rstrip()
    if not isinstance(content, list):
        return ""
    parts: list[str] = []
    for c in content:
        if not isinstance(c, dict):
            continue
        t = c.get("type")
        if t == "text":
            txt = c.get("text", "")
            txt = txt.rstrip() if isinstance(txt, str) else ""
            if txt:
                parts.append(txt)
        elif t == "thinking":
            txt = c.get("thinking", "")
            txt = txt.rstrip() if isinstance(txt, str) else ""
            if txt:
                parts.append(f"  ⟪ thinking: {short(txt, 200)} ⟫")
        elif t == "toolCall":
            name = c.get("name", "?")
            inp = c.get("arguments") or {}
            hint = ""
            if isinstance(inp, dict):
                for key in (
                    "command",
                    "file_path",
                    "path",
                    "query",
                    "pattern",
                    "prompt",
                    "url",
                    "skill",
                    "op",
                ):
                    v = inp.get(key)
                    if isinstance(v, str) and v.strip():
                        hint = short(v)
                        break
                if not hint:
                    for v in inp.values():
                        if isinstance(v, str) and v.strip():
                            hint = short(v)
                            break
            parts.append(f"  → {name}({hint})" if hint else f"  → {name}()")
    return "\n\n".join(parts).rstrip()


def tool_result_block(msg: dict) -> str:
    tc = text_of(msg.get("content"))
    if len(tc) > 400:
        tc = tc[:400] + f"\n…(+{len(tc)-400} chars)"
    name = msg.get("toolName", "tool")
    err = " [error]" if msg.get("isError") else ""
    return f"  ↳ {name}{err}:\n{indent(tc)}"


def fmt(line: str) -> str | None:
    try:
        d = json.loads(line)
    except Exception:
        return None
    if not isinstance(d, dict):
        return None
    t = d.get("type")
    ts = fmt_ts(d.get("timestamp", ""))
    if t == "session":
        cwd = d.get("cwd", "")
        return f"# omp session {d.get('id', '')}  ·  {cwd}  ·  {ts}\n"
    if t == "message":
        msg = d.get("message", {})
        if not isinstance(msg, dict):
            return None
        role = msg.get("role")
        if role == "user":
            text = text_of(msg.get("content"))
            if not text:
                return None
            sep = "─" * WIDTH
            return f"\n{sep}\n  YOU  {ts}\n{sep}\n{text}\n"
        if role == "assistant":
            body = assistant_block(msg)
            if not body:
                return None
            model = msg.get("model", "")
            sep = "═" * WIDTH
            head = f"  OMP  {ts}" + (f"  · {model}" if model else "")
            return f"\n{sep}\n{head}\n{sep}\n{body}\n"
        if role == "toolResult":
            body = tool_result_block(msg)
            if not body:
                return None
            return f"\n{body}\n"
        return None
    if t == "compaction":
        sep = "·" * WIDTH
        summary = d.get("summary")
        summary = summary.strip() if isinstance(summary, str) else ""
        return f"\n{sep}\n  COMPACTION\n{sep}\n{summary}\n"
    if t in ("title", "title_change"):
        title = d.get("title")
        title = title.strip() if isinstance(title, str) else ""
        if not title:
            return None
        return f"\n## {title}\n"
    return None


def main() -> int:
    if len(sys.argv) < 2:
        print("usage: omp-jsonl-pretty <path>", file=sys.stderr)
        return 1
    path = sys.argv[1]
    try:
        fp = open(path, encoding="utf-8", errors="replace")
    except OSError as e:
        print(f"cannot open {path}: {e}", file=sys.stderr)
        return 1
    try:
        for line in fp:
            out = fmt(line)
            if out:
                sys.stdout.write(safe_text(out))
        sys.stdout.flush()
    except BrokenPipeError:
        # Avoid another broken-pipe exception during interpreter shutdown.
        import os
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
    return 0


if __name__ == "__main__":
    sys.exit(main())
