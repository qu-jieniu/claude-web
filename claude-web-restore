#!/bin/bash
# Re-spawn claude-launcher screen sessions recorded in state/sessions/*.env.
# Invoked by ~/.config/systemd/user/claude-web-restore.service on boot, or
# manually at any time. Safe to re-run: already-running sessions are skipped.
#
# For claude sessions, this uses `claude --continue` so the session resumes
# the latest JSONL in its project dir rather than the (older) UUID originally
# launched — matches the session's current state, not its launch point.
set -uo pipefail

STATE_DIR="$HOME/claude-web/state/sessions"
mkdir -p "$STATE_DIR"

# --sync: probe currently-running claude-* screens and write missing .env files.
# Used to bootstrap state for sessions that predate this feature. Excludes
# claude-discord (systemd-managed with a bespoke bootstrap).
if [ "${1:-}" = "--sync" ]; then
    line=""
    while IFS= read -r line; do
        [[ "$line" =~ ([0-9]+)\.claude-([^[:space:]]+) ]] || continue
        pid="${BASH_REMATCH[1]}"
        name="claude-${BASH_REMATCH[2]}"
        [ "$name" = "claude-discord" ] && { echo "skip $name (systemd-managed)"; continue; }
        [ -f "$STATE_DIR/$name.env" ] && { echo "skip $name (state exists)"; continue; }
        bash_pid=$(pgrep -P "$pid" -n 2>/dev/null | head -1)
        if [ -z "$bash_pid" ]; then echo "skip $name (no child proc)"; continue; fi
        cwd=$(readlink "/proc/$bash_pid/cwd" 2>/dev/null)
        [ -z "$cwd" ] || [ ! -d "$cwd" ] && cwd="$HOME"
        if pstree -p "$pid" 2>/dev/null | grep -q 'claude('; then kind=claude; else kind=shell; fi
        {
            printf 'KIND=%s\n' "$kind"
            printf 'CWD=%q\n' "$cwd"
            printf 'SKIP_PERMS=0\n'
        } > "$STATE_DIR/$name.env"
        echo "synced $name kind=$kind cwd=$cwd"
    done < <(screen -ls 2>/dev/null)
    exit 0
fi

# When invoked under systemd (Type=oneshot), the service's cgroup is torn
# down as soon as this script exits — taking every screen we just spawned
# with it (KillMode=control-group is the default). Run each screen in its
# own transient scope via systemd-run so it lives outside our cgroup and
# survives the restore service's exit. Interactive invocations (no
# INVOCATION_ID) skip the wrapper — screen already daemonizes fine.
if [ -n "${INVOCATION_ID:-}" ] && command -v systemd-run >/dev/null 2>&1; then
    scope_run() { systemd-run --user --scope --quiet --collect --unit="$1.scope" -- "${@:2}"; }
else
    scope_run() { shift; "$@"; }
fi

shopt -s nullglob
for env in "$STATE_DIR"/*.env; do
    name=$(basename "$env" .env)
    if screen -ls 2>/dev/null | grep -q "\.$name[[:space:]]"; then
        echo "skip $name (already running)"
        continue
    fi

    (
        KIND=""; CWD=""; SKIP_PERMS=0; UUID=""
        # shellcheck disable=SC1090
        source "$env"
        flags=""
        [ "${SKIP_PERMS:-0}" = "1" ] && flags=" --dangerously-skip-permissions"
        case "$KIND" in
            shell)
                scope_run "claude-restore-$name" screen -dmS "$name" bash -l
                echo "restored shell $name"
                ;;
            claude)
                if [ -z "$CWD" ] || [ ! -d "$CWD" ]; then
                    echo "skip $name (cwd missing: ${CWD:-unset})"
                    exit 0
                fi
                if [ -n "$UUID" ]; then
                    resume_cmd="claude --resume \"$UUID\"${flags}"
                    echo "restored claude $name (cwd=$CWD, uuid=$UUID)"
                else
                    resume_cmd="claude --continue${flags}"
                    echo "restored claude $name (cwd=$CWD)"
                fi
                scope_run "claude-restore-$name" screen -dmS "$name" bash -lc "cd \"$CWD\" && $resume_cmd; exec \"\$SHELL\""
                ;;
            *)
                echo "skip $name (unknown KIND=${KIND:-unset})"
                ;;
        esac
    )
done
