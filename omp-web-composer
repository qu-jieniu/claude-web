#!/usr/bin/env python3
"""Same-origin HTTP adapter for the opt-in OMP composer extension's private IPC."""

import argparse
import hashlib
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import os
from pathlib import Path
import re
import socket
import sqlite3
import stat
import subprocess
from urllib.parse import parse_qs, urlsplit

MAX_BODY = 1024 * 1024
MAX_TEXT = 262144
WINDOW = re.compile(r"tmux-[0-9]{1,12}\Z")
PANE = re.compile(r"%[0-9]{1,12}\Z")
REQUEST_ID = re.compile(r"[A-Za-z0-9_-]{16,128}\Z")


class Rejected(Exception):
    def __init__(self, message, status=409, ambiguous=False):
        super().__init__(message)
        self.status = status
        self.reply = {"error": message}
        if ambiguous:
            self.reply["ambiguous"] = True


def private_directory(path):
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise ValueError("Composer runtime directory must be owned by this user and mode 0700")


class Composer:
    def __init__(self):
        self.directory = Path(os.environ.get("OMP_COMPOSER_DIR", "~/.omp/run/web-composer")).expanduser().absolute()
        private_directory(self.directory)
        self.tmux = ["tmux", "-u"]
        socket_path = os.environ.get("OMP_TMUX_SOCKET")
        if socket_path:
            self.tmux += ["-S", os.path.expanduser(socket_path)]
        self.environment = dict(os.environ, LC_ALL="C.UTF-8", LANG="C.UTF-8")
        if socket_path:
            self.environment.pop("TMUX", None)
        # Persist uncertainty before dispatch: service/container restarts cannot replay it.
        self.database = self.directory / "requests.sqlite3"
        if self.database.exists():
            info = self.database.lstat()
            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
                raise ValueError("Composer request ledger must be an owner-private regular file")
        with self.connect() as db:
            db.execute("CREATE TABLE IF NOT EXISTS requests (id TEXT PRIMARY KEY, fingerprint TEXT NOT NULL, status INTEGER, reply TEXT)")

    def connect(self):
        return sqlite3.connect(self.database, timeout=5)

    def active_pane(self, window_id):
        if not isinstance(window_id, str) or not WINDOW.fullmatch(window_id):
            raise Rejected("Select an explicit tmux window before composing.", 400)
        format_ = "\t".join(["#{pid}", "#{window_id}", "#{pane_id}", "#{pane_active}", "#{pane_dead}", "#{pane_in_mode}"])
        try:
            result = subprocess.run(self.tmux + ["list-panes", "-t", "@" + window_id[5:], "-F", format_],
                                    env=self.environment, capture_output=True, text=True, timeout=2)
        except (OSError, subprocess.TimeoutExpired):
            raise Rejected("The tmux server is unavailable.") from None
        if result.returncode:
            raise Rejected("The selected tmux window no longer exists.")
        rows = [line.split("\t") for line in result.stdout.splitlines()]
        active = [row for row in rows if len(row) == 6 and row[1] == "@" + window_id[5:] and row[3] == "1"]
        if len(active) != 1 or not PANE.fullmatch(active[0][2]) or not active[0][0].isdigit():
            raise Rejected("Cannot identify a unique active pane.")
        row = active[0]
        if row[4] != "0":
            raise Rejected("The selected pane has exited.")
        if row[5] != "0":
            raise Rejected("Exit tmux copy mode before sending.")
        return {"windowId": window_id, "paneId": row[2], "serverPid": row[0]}

    def metadata(self, pane):
        for file in self.directory.glob("*.json"):
            try:
                info = file.lstat()
                if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077 or info.st_size > 8192:
                    continue
                with file.open(encoding="utf-8") as stream:
                    meta = json.load(stream)
                if not isinstance(meta, dict) or meta.get("v") != 1 or meta.get("paneId") != pane["paneId"] or meta.get("serverPid") != pane["serverPid"]:
                    continue
                if not isinstance(meta.get("token"), str) or not re.fullmatch(r"[0-9a-f]{64}", meta["token"]):
                    continue
                endpoint = Path(meta.get("endpoint", ""))
                if endpoint != file.with_suffix(".sock"):
                    continue
                info = endpoint.lstat()
                if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
                    continue
                yield meta
            except (OSError, ValueError, TypeError):
                continue

    @staticmethod
    def bridge(meta, op, data=None):
        sent = False
        try:
            payload = json.dumps({"v": 1, "token": meta["token"], "op": op, **(data or {})}, ensure_ascii=False).encode("utf-8") + b"\n"
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
                connection.settimeout(18 if op == "send" else 3)
                connection.connect(meta["endpoint"])
                sent = True
                connection.sendall(payload)
                response = bytearray()
                while b"\n" not in response:
                    chunk = connection.recv(4096)
                    if not chunk or len(response) + len(chunk) > 65536:
                        raise ValueError("Invalid bridge reply")
                    response.extend(chunk)
            reply = json.loads(bytes(response).split(b"\n", 1)[0])
            if not isinstance(reply, dict):
                raise ValueError("Invalid bridge reply")
            return reply
        except (OSError, ValueError):
            if sent and op == "send":
                raise Rejected("OMP did not confirm submission. Check the conversation before sending again.", 502, True) from None
            raise Rejected("The OMP composer bridge is unavailable.", 503) from None

    def target(self, window_id):
        pane = self.active_pane(window_id)
        found = []
        for meta in self.metadata(pane):
            try:
                state = self.bridge(meta, "snapshot")
            except Rejected:
                continue
            if all(state.get(key) == value for key, value in pane.items()) and isinstance(state.get("sessionId"), str) and state["sessionId"]:
                found.append((meta, state))
        if not found:
            raise Rejected("No supported OMP session in this pane. Start or resume OMP with the composer bridge; shells and existing unbridged sessions cannot receive Compose prompts.")
        if len(found) != 1:
            raise Rejected("Multiple OMP sessions claim this pane; return to a single foreground OMP session.")
        meta, state = found[0]
        if state.get("available") is not True:
            raise Rejected(state.get("reason") or "The OMP session is not ready.")
        return pane, meta, state

    def get_target(self, window_id):
        try:
            pane, _meta, state = self.target(window_id)
            return {"available": True, "paneId": pane["paneId"], "sessionId": state["sessionId"]}
        except Rejected as error:
            return {"available": False, "reason": error.reply["error"]}

    def send(self, request):
        keys = {"windowId", "paneId", "sessionId", "requestId", "text"}
        if not isinstance(request, dict) or set(request) != keys or not all(isinstance(value, str) for value in request.values()):
            raise Rejected("The composer request has invalid fields.", 400)
        if not WINDOW.fullmatch(request["windowId"]) or not PANE.fullmatch(request["paneId"]) or not REQUEST_ID.fullmatch(request["requestId"]) or not 1 <= len(request["sessionId"]) <= 1024:
            raise Rejected("The composer target or request ID is invalid.", 400)
        text = request["text"]
        try:
            text_size = len(text.encode("utf-8"))
        except UnicodeError:
            raise Rejected("The prompt is not valid UTF-8.", 400) from None
        if not text.strip() or "\0" in text or text_size > MAX_TEXT:
            raise Rejected("Enter a nonempty prompt of at most 256 KiB without NUL characters.", 400)
        fingerprint = hashlib.sha256(json.dumps(request, sort_keys=True, ensure_ascii=True).encode()).hexdigest()
        with self.connect() as db:
            inserted = db.execute("INSERT OR IGNORE INTO requests(id, fingerprint) VALUES (?, ?)", (request["requestId"], fingerprint)).rowcount
            if not inserted:
                prior = db.execute("SELECT fingerprint, status, reply FROM requests WHERE id = ?", (request["requestId"],)).fetchone()
                if prior[0] != fingerprint:
                    raise Rejected("This request ID was already used for another prompt.")
                if prior[1] is None:
                    raise Rejected("This request was already attempted but its outcome is unknown. Check the conversation before sending again.", 409, True)
                return prior[1], json.loads(prior[2])
        try:
            pane, meta, state = self.target(request["windowId"])
            if pane["paneId"] != request["paneId"] or state["sessionId"] != request["sessionId"]:
                raise Rejected("The target session or active pane changed. Check the target again.")
            # The bridge independently rechecks activepane, foreground state and
            # current session immediately before invoking the OMP session API.
            reply = self.bridge(meta, "send", {**request, "serverPid": pane["serverPid"]})
            if reply.get("accepted") is True and reply.get("requestId") == request["requestId"]:
                status, response = 200, {"accepted": True, "requestId": request["requestId"]}
            elif isinstance(reply.get("error"), str):
                status, response = 409, {"error": reply["error"]}
                if reply.get("ambiguous") is True:
                    response["ambiguous"] = True
            else:
                raise Rejected("OMP returned no submission acknowledgement. Check the conversation before sending again.", 502, True)
        except Rejected as error:
            status, response = error.status, error.reply
        try:
            with self.connect() as db:
                db.execute("UPDATE requests SET status = ?, reply = ? WHERE id = ?", (status, json.dumps(response), request["requestId"]))
        except sqlite3.Error:
            # The durable pending record still prevents replay. Do not turn a
            # witnessed acceptance into a rejection merely because saving failed.
            pass
        return status, response


class Handler(BaseHTTPRequestHandler):
    server_version = "OMPComposer"

    def log_message(self, _format, *_args):
        pass  # No request content, capabilities or credentials in access logs.

    def setup(self):
        super().setup()
        self.connection.settimeout(25)

    def reply(self, status, payload):
        body = json.dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.wfile.write(body)

    def same_origin(self):
        hosts, origins = self.headers.get_all("Host", []), self.headers.get_all("Origin", [])
        if len(hosts) != 1 or len(origins) != 1:
            return False
        try:
            origin = urlsplit(origins[0])
            host = urlsplit("//" + hosts[0])
            return (origin.scheme in ("http", "https") and origin.netloc.lower() == hosts[0].lower()
                    and bool(host.hostname) and not host.username and not origin.username
                    and not origin.path and not origin.query and not origin.fragment
                    and not host.path and not host.query and not host.fragment
                    and self.headers.get("Sec-Fetch-Site", "same-origin") in ("same-origin", "none"))
        except ValueError:
            return False

    def do_GET(self):
        parsed = urlsplit(self.path)
        query = parse_qs(parsed.query, keep_blank_values=True)
        if parsed.path != "/composer/target":
            self.reply(404, {"error": "Unknown composer endpoint."})
        elif set(query) != {"window"} or len(query["window"]) != 1:
            self.reply(400, {"error": "Supply exactly one window target."})
        else:
            self.reply(200, self.server.composer.get_target(query["window"][0]))

    def do_POST(self):
        try:
            if self.path != "/composer/send":
                raise Rejected("Unknown composer endpoint.", 404)
            if not self.same_origin():
                raise Rejected("A same-origin request matching Host is required.", 403)
            if self.headers.get_content_type() != "application/json" or self.headers.get("Transfer-Encoding"):
                raise Rejected("Send a JSON request with Content-Length.", 415)
            lengths = self.headers.get_all("Content-Length", [])
            if len(lengths) != 1 or not lengths[0].isascii() or not lengths[0].isdigit() or len(lengths[0]) > 8:
                raise Rejected("A valid Content-Length is required.", 411)
            length = int(lengths[0])
            if not 0 < length <= MAX_BODY:
                raise Rejected("The composer request is too large or empty.", 413)
            raw = self.rfile.read(length)
            if len(raw) != length:
                raise Rejected("The composer request was incomplete.", 400)
            try:
                request = json.loads(raw)
            except (ValueError, UnicodeError, RecursionError):
                raise Rejected("The composer request is not valid JSON.", 400) from None
            status, response = self.server.composer.send(request)
            self.reply(status, response)
        except Rejected as error:
            self.reply(error.status, error.reply)
        except (OSError, sqlite3.Error):
            self.reply(503, {"error": "Composer service is unavailable; no submission was confirmed.", "ambiguous": True})

    def do_OPTIONS(self):
        self.reply(405, {"error": "Cross-origin composer requests are not supported."})


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--port", type=int, default=int(os.environ.get("OMP_COMPOSER_PORT", "7683")))
    args = parser.parse_args()
    if not 1 <= args.port <= 65535:
        parser.error("--port must be between 1 and 65535")
    os.umask(0o077)
    server = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    server.daemon_threads = True
    server.composer = Composer()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


if __name__ == "__main__":
    main()
