#!/bin/bash
# Interactive session picker for Claude Code, backed by named `screen` sessions.
# Used as ttyd's entry point (claude-web.service) and as the local `claude-attach`
# function. Each project lives in its own `claude-<name>` screen session.
set -uo pipefail

PROJECTS_DIR="$HOME/.claude/projects"

sanitize() { printf '%s' "$1" | tr -c 'a-zA-Z0-9_-' '_' | tr -s '_'; }

# Emit an OSC 0 escape to set the terminal/browser-tab title. ttyd reflects
# this in the page <title>. Works only because the systemd unit advertises
# TERM=ttyd-256color (a custom terminfo without "xterm" in the name and
# without kmous=\E[M), which makes screen's D_CXT flag stay 0 and stops it
# from forwarding inner programs' \e]0;<title>\007 sequences to the outer
# terminal. With D_CXT=1 (the default xterm-256color path), every claude
# turn would push the chat topic over our title. See:
# screen-4.9.1/termcap.c near "InStr(D_termname, \"xterm\")" and
# screen-4.9.1/display.c SetXtermOSC for the forwarding code path.
set_title() { printf '\033]0;%s\007' "$1"; }

# Per-session screenrc generator: bakes the status-bar backtick (one per
# session because backticks run in screen's main process context, so the
# session name has to be hard-coded) plus the Ctrl-A j keybinding that
# opens the live JSONL view in a new window.
STATUS_SCRIPT="$HOME/claude-web/claude-status"
JSONL_VIEW_SCRIPT="$HOME/claude-web/claude-jsonl-view"
RC_DIR="/tmp/claude-web-rc"
generate_session_rc() {
    local sname="$1" rc
    mkdir -p "$RC_DIR"
    rc="$RC_DIR/${sname}.rc"
    {
        printf 'source /etc/screenrc\n'
        printf 'backtick 0 30 30 %q %q\n' "$STATUS_SCRIPT" "$sname"
        printf 'caption always "%%S | %%\x60"\n'
        # Ctrl-A j → new window titled jsonl, running the JSONL viewer.
        # less is built into less; the helper just resolves the path.
        printf 'bind j screen -t jsonl %q\n' "$JSONL_VIEW_SCRIPT"
    } > "$rc"
    printf '%s' "$rc"
}

# Idempotent retrofit for screens created before the launcher knew about
# the status bar / JSONL binding (or for sessions like claude-discord that
# come from a different bootstrap). Re-sources the per-session rc, so any
# new directive added to generate_session_rc gets picked up automatically
# on the next attach.
apply_session_config() {
    local sname="$1"
    local rc; rc=$(generate_session_rc "$sname")
    screen -S "$sname" -X source "$rc" 2>/dev/null || true
}

# Given a cwd, return the encoded ~/.claude/projects/ dir name: / and . → -
project_dir_for() { printf '%s/%s' "$PROJECTS_DIR" "$(printf '%s' "$1" | sed 's|[/.]|-|g')"; }

short_name_for() {
    local path="$1" base
    if [ "$path" = "$HOME" ]; then echo "home"; return; fi
    base=$(sanitize "$(basename "$path")")
    # Avoid double-prefix like claude-claude-web when basename already starts with claude-
    base="${base#claude-}"
    [ -z "$base" ] && base="session"
    printf '%s' "$base"
}

time_ago() {
    local now diff
    now=$(date +%s); diff=$(( now - $1 ))
    if   (( diff < 60 ));    then echo "${diff}s ago"
    elif (( diff < 3600 ));  then echo "$((diff/60))m ago"
    elif (( diff < 86400 )); then echo "$((diff/3600))h ago"
    else echo "$((diff/86400))d ago"
    fi
}

extract_cwd() {
    python3 - "$1" <<'PY' 2>/dev/null
import json, sys
try:
    with open(sys.argv[1]) as fp:
        for line in fp:
            line = line.strip()
            if not line: continue
            try: d = json.loads(line)
            except Exception: continue
            if isinstance(d, dict) and 'cwd' in d:
                print(d['cwd']); break
except Exception:
    pass
PY
}

extract_first_user_msg() {
    python3 - "$1" <<'PY' 2>/dev/null
import json, sys
def flat(c):
    if isinstance(c, str): return c
    if isinstance(c, list):
        parts = []
        for x in c:
            if isinstance(x, dict) and x.get('type') == 'text':
                parts.append(x.get('text', ''))
        return ' '.join(parts)
    return ''
try:
    with open(sys.argv[1]) as fp:
        for line in fp:
            line = line.strip()
            if not line: continue
            try: d = json.loads(line)
            except Exception: continue
            if d.get('type') in ('user', 'human'):
                msg = d.get('message', d.get('content', ''))
                if isinstance(msg, dict):
                    text = flat(msg.get('content', ''))
                else:
                    text = flat(msg)
                text = ' '.join(text.split())  # collapse whitespace
                if text:
                    print(text[:100]); break
except Exception:
    pass
PY
}

list_running_detailed() {
    # Emits: name|pid|state(A/D)|start_epoch
    local now; now=$(date +%s)

    # First pass: parse screen -ls into pid|name|state and collect pids
    local -a rows=()
    local pids="" line pid name state
    while IFS= read -r line; do
        [[ "$line" =~ ([0-9]+)\.claude-([^[:space:]]+).*\(([A-Za-z]+)\) ]] || continue
        pid="${BASH_REMATCH[1]}"
        name="${BASH_REMATCH[2]}"
        case "${BASH_REMATCH[3]}" in
            Attached) state="A" ;;
            Detached) state="D" ;;
            Dead) state="X" ;;
            *) state="?" ;;
        esac
        rows+=("$name|$pid|$state")
        pids+=" $pid"
    done < <(screen -ls 2>/dev/null)

    [ ${#rows[@]} -eq 0 ] && return

    # Second pass: ONE ps call for all pids — ~12x faster than per-screen fork
    # at ~10 screens, since each fork+exec dominates over the actual work.
    local -A etimes_by_pid=()
    local p e
    while read -r p e; do
        [[ "$p" =~ ^[0-9]+$ ]] && [[ "$e" =~ ^[0-9]+$ ]] && etimes_by_pid[$p]=$e
    done < <(ps -o pid=,etimes= -p $pids 2>/dev/null)

    # Emit final rows with computed start_epoch
    local row e start
    for row in "${rows[@]}"; do
        IFS='|' read -r name pid state <<< "$row"
        e="${etimes_by_pid[$pid]:-0}"
        start=$(( now - e ))
        printf '%s|%s|%s|%s\n' "$name" "$pid" "$state" "$start"
    done
}

list_projects() {
    # Single Python pass over all project dirs — replaces what used to be
    # 39× per-project Python subprocesses (one per `extract_cwd` call) that
    # together took ~3.7s on a real workload. The hot loop is reading the
    # first non-empty line of the newest JSONL in each dir, so it's the
    # subprocess-startup cost that dominated, not the actual work.
    python3 - "$PROJECTS_DIR" "$HOME" <<'PY'
import json, os, re, sys
projects_dir, home = sys.argv[1], sys.argv[2]

def sanitize(s):
    return re.sub(r'_+', '_', re.sub(r'[^a-zA-Z0-9_-]', '_', s))

def short_name(cwd):
    if cwd == home: return 'home'
    base = sanitize(os.path.basename(cwd))
    if base.startswith('claude-'):
        base = base[len('claude-'):]
    return base or 'session'

def newest_jsonl(pdir):
    best = None
    best_m = -1
    try:
        for f in os.listdir(pdir):
            if not f.endswith('.jsonl'): continue
            p = f"{pdir}/{f}"
            try: m = os.path.getmtime(p)
            except OSError: continue
            if m > best_m:
                best_m, best = m, p
    except OSError:
        pass
    return best, best_m

def extract_cwd(path):
    try:
        with open(path) as fp:
            for line in fp:
                line = line.strip()
                if not line: continue
                try: d = json.loads(line)
                except Exception: continue
                if isinstance(d, dict) and 'cwd' in d:
                    return d['cwd']
    except Exception:
        pass
    return None

rows = []
try:
    entries = os.listdir(projects_dir)
except OSError:
    sys.exit(0)
for entry in entries:
    pdir = f"{projects_dir}/{entry}"
    if not os.path.isdir(pdir): continue
    newest, mtime = newest_jsonl(pdir)
    if newest is None: continue
    cwd = extract_cwd(newest)
    if not cwd or not os.path.isdir(cwd): continue
    rows.append((short_name(cwd), cwd, int(mtime), pdir))

rows.sort(key=lambda r: -r[2])
for r in rows:
    print('|'.join(str(x) for x in r))
PY
}

list_sessions_in() {
    # Sessions in a project dir, sorted newest-first.
    # Output: uuid|mtime|first-user-msg
    #
    # Single Python pass over all JSONLs in the dir — used to be a per-file
    # subprocess for `extract_first_user_msg`. That cost ~24s on a project
    # with 229 JSONLs because of subprocess startup × N.
    python3 - "$1" <<'PY'
import json, os, sys
pdir = sys.argv[1]

def first_user(path):
    try:
        with open(path) as fp:
            for line in fp:
                line = line.strip()
                if not line: continue
                try: d = json.loads(line)
                except Exception: continue
                if d.get('type') in ('user', 'human'):
                    msg = d.get('message', d.get('content', ''))
                    if isinstance(msg, dict):
                        c = msg.get('content', '')
                    else:
                        c = msg
                    if isinstance(c, list):
                        parts = [x.get('text', '') for x in c if isinstance(x, dict) and x.get('type') == 'text']
                        c = ' '.join(parts)
                    if isinstance(c, str) and c.strip():
                        return ' '.join(c.split())[:100]
    except Exception:
        pass
    return ''

rows = []
try:
    entries = os.listdir(pdir)
except OSError:
    sys.exit(0)
for f in entries:
    if not f.endswith('.jsonl'): continue
    path = f"{pdir}/{f}"
    try:
        mtime = int(os.path.getmtime(path))
    except OSError:
        continue
    uuid = f[:-len('.jsonl')]
    preview = first_user(path) or '(no user messages)'
    rows.append((uuid, mtime, preview))

rows.sort(key=lambda r: -r[1])
for uuid, mtime, preview in rows:
    print(f'{uuid}|{mtime}|{preview}')
PY
}

banner() {
    clear
    set_title "claude-launcher"
    printf '\n'
    printf '  Claude Code — session launcher\n'
    printf '  %s\n\n' "$(date '+%F %H:%M')"
    printf '  screen:  Ctrl-A d   = detach (back to this menu)\n'
    printf '           Ctrl-A a d = detach an inner nested screen\n'
    printf '           Ctrl-A [   = scroll mode (PgUp/PgDn, / and ? search, q exit)\n'
    printf '           Ctrl-A j   = live JSONL view of this session (q to close)\n\n'
}

attach_session() {
    set_title "claude-$1"
    apply_session_config "claude-$1"
    screen -A -D -RR -S "claude-$1"
}

screen_exists() { screen -ls 2>/dev/null | grep -q "\.$1[[:space:]]"; }

next_shell_name() {
    # Returns the next unused shell suffix: shell, shell-2, shell-3, ...
    local i=1 name="shell"
    while screen_exists "claude-$name"; do
        i=$((i+1)); name="shell-$i"
    done
    printf '%s' "$name"
}

launch_new_screen() {
    # $1 = full screen name (claude-<suffix>)  $2 = cwd  $3 = claude args (may be empty)
    # Ephemeral — no .env is written.
    local sname="$1" cwd="$2" args="$3"
    set_title "$sname"
    local rc; rc=$(generate_session_rc "$sname")
    # Auto-enable Claude Code's Remote Control (--remote-control <name>) so
    # this session shows up in claude.ai for cross-device drive-by control.
    # Name passed is the screen suffix (e.g. "trader" from "claude-trader");
    # claude.ai surfaces it as "<hostname>-<name>" via the default prefix.
    # Skip if the caller already passed --remote-control, or if the env var
    # CLAUDE_WEB_NO_REMOTE is set (privacy-sensitive work, etc.).
    local rc_arg=""
    if [ -z "${CLAUDE_WEB_NO_REMOTE:-}" ] && [[ "$args" != *"--remote-control"* ]]; then
        rc_arg=" --remote-control ${sname#claude-}"
    fi
    screen -c "$rc" -S "$sname" bash -lc "cd \"$cwd\" && claude${rc_arg} ${args}; exec \"\$SHELL\""
}

rename_session() {
    local old="$1" input new_suffix new_name
    read -erp "New name for claude-$old [claude-$old]: " input
    input="${input:-$old}"
    # Strip claude- so typing "claude-foo" doesn't become claude-claude-foo
    input="${input#claude-}"
    new_suffix=$(sanitize "$input")
    [ -z "$new_suffix" ] && { echo "invalid name"; sleep 1; return 1; }
    if [ "$new_suffix" = "$old" ]; then
        echo "(name unchanged)"; sleep 1; return 0
    fi
    new_name="claude-$new_suffix"
    if screen_exists "$new_name"; then
        echo "A screen named $new_name already exists. Pick another name."; sleep 2; return 1
    fi
    if screen -S "claude-$old" -X sessionname "$new_name"; then
        echo "Renamed claude-$old -> $new_name."
    else
        echo "Rename failed."
    fi
    sleep 1
}

resume_specific_session() {
    local name="$1" cwd="$2" uuid="$3"
    local short="${uuid:0:8}"
    local default="${name}-${short}"
    local n sname
    n=$(prompt_screen_name "$default") || { echo "invalid name"; sleep 1; return 1; }
    sname="claude-$n"
    if screen_exists "$sname"; then
        echo
        echo "Warning: screen '$sname' already exists — attaching to it instead of resuming $short."
        echo "The existing session keeps its original UUID and flags; nothing is resumed."
        read -erp "Press Enter to attach anyway, or Ctrl-C to cancel: " _
        set_title "$sname"
        apply_session_config "$sname"
        screen -A -D -RR -S "$sname"
    else
        local flags; flags=$(prompt_skip_perms)
        launch_new_screen "$sname" "$cwd" "--resume $uuid${flags}"
    fi
}

pick_by_uuid() {
    local input full_uuid matches=()
    read -erp "UUID (full or 8+ char prefix): " input || return
    input=$(echo "$input" | tr -d '[:space:]')
    [ -z "$input" ] && return
    [ "${#input}" -lt 8 ] && { echo "need 8+ chars"; sleep 1; return; }

    # Find matching jsonl files under any project dir.
    while IFS= read -r f; do matches+=("$f"); done < <(compgen -G "$PROJECTS_DIR/*/$input*.jsonl" 2>/dev/null || true)

    if [ "${#matches[@]}" -eq 0 ]; then
        echo "No session matching $input"; sleep 2; return
    fi
    if [ "${#matches[@]}" -gt 1 ]; then
        echo "Ambiguous — matches:"
        printf '  %s\n' "${matches[@]}"
        sleep 3; return
    fi
    local f="${matches[0]}"
    full_uuid=$(basename "$f" .jsonl)
    local cwd; cwd=$(extract_cwd "$f")
    if [ -z "$cwd" ] || [ ! -d "$cwd" ]; then
        echo "cwd not found or stale for $full_uuid"; sleep 2; return
    fi
    local sel_name; sel_name=$(short_name_for "$cwd")
    echo "Found: $full_uuid  cwd=$cwd"
    resume_specific_session "$sel_name" "$cwd" "$full_uuid"
}

pick_session_menu() {
    banner
    echo "Pick a project (or type a UUID directly):"
    echo
    local -a plabels=() pcwds=() pdirs=() pnames=()
    local name cwd mtime pdir
    while IFS='|' read -r name cwd mtime pdir; do
        [ -z "$name" ] && continue
        plabels+=("$name  —  $cwd  ($(time_ago "$mtime"))")
        pcwds+=("$cwd")
        pdirs+=("$pdir")
        pnames+=("$name")
    done < <(list_projects)
    plabels+=("[id] Type UUID directly...")
    plabels+=("cancel")

    PS3=$'\nproject: '
    local opt
    select opt in "${plabels[@]}"; do
        [ -z "${opt:-}" ] && continue
        [ "$opt" = "cancel" ] && return
        if [ "$opt" = "[id] Type UUID directly..." ]; then
            pick_by_uuid; return
        fi
        local idx=$(( REPLY - 1 ))
        (( idx < 0 || idx >= ${#pcwds[@]} )) && continue
        local sel_name="${pnames[$idx]}"
        local sel_cwd="${pcwds[$idx]}"
        local sel_pdir="${pdirs[$idx]}"

        echo
        echo "Sessions in $sel_name (newest first):"
        echo
        local -a slabels=() suuids=()
        local uuid stime preview
        while IFS='|' read -r uuid stime preview; do
            [ -z "$uuid" ] && continue
            slabels+=("${uuid:0:8}  ($(time_ago "$stime"))  ${preview:0:70}")
            suuids+=("$uuid")
        done < <(list_sessions_in "$sel_pdir")
        if [ "${#suuids[@]}" -eq 0 ]; then
            echo "(no sessions in $sel_pdir)"; sleep 1; return
        fi
        slabels+=("cancel")

        PS3=$'\nsession: '
        local sopt
        select sopt in "${slabels[@]}"; do
            [ -z "${sopt:-}" ] && continue
            [ "$sopt" = "cancel" ] && return
            local sidx=$(( REPLY - 1 ))
            (( sidx < 0 || sidx >= ${#suuids[@]} )) && continue
            resume_specific_session "$sel_name" "$sel_cwd" "${suuids[$sidx]}"
            return
        done
        return
    done
}

prompt_screen_name() {
    # $1 = default (without claude- prefix). Prints chosen name on stdout (also without prefix).
    local default="$1" input n
    read -erp "Screen name [claude-$default]: " input
    input="${input:-$default}"
    # Strip claude- so typing "claude-foo" doesn't become claude-claude-foo
    input="${input#claude-}"
    n=$(sanitize "$input")
    [ -z "$n" ] && { echo "" ; return 1; }
    printf '%s' "$n"
}

prompt_skip_perms() {
    local ans
    read -erp "Skip permissions (--dangerously-skip-permissions)? [y/N]: " ans
    case "${ans,,}" in
        y|yes) printf ' --dangerously-skip-permissions' ;;
        *) printf '' ;;
    esac
}

prompt_custom_path() {
    local p default n sname ans
    read -erp "Path (Tab to complete): " p || return 1
    p="${p/#\~/$HOME}"
    [ -z "$p" ] && return 1
    if [ ! -e "$p" ]; then
        read -erp "Path does not exist. Create it? [Y/n]: " ans
        case "${ans,,}" in
            n|no) echo "cancelled"; sleep 1; return 1 ;;
        esac
        mkdir -p "$p" || { echo "mkdir failed"; sleep 1; return 1; }
    fi
    p=$(realpath -e "$p" 2>/dev/null) || { echo "invalid path"; sleep 1; return 1; }
    [ -d "$p" ] || { echo "not a directory"; sleep 1; return 1; }
    default=$(short_name_for "$p")
    n=$(prompt_screen_name "$default") || { echo "invalid name"; sleep 1; return 1; }
    sname="claude-$n"
    if screen_exists "$sname"; then
        echo "A screen named $sname already exists. Pick another name."; sleep 2; return 1
    fi
    local flags; flags=$(prompt_skip_perms)
    launch_new_screen "$sname" "$p" "$flags"
}

pick_running_menu() {
    # $1 = verb (e.g. "kill", "rename") — drives the prompt text
    # $2 = callback function name, invoked as "<callback> <screen-suffix>"
    local verb="$1" callback="$2"
    banner
    echo "Running screens (pick one to $verb):"
    echo
    local -a names=()
    local n
    while IFS='|' read -r n _ _ _; do
        [ -z "$n" ] && continue
        names+=("$n")
    done < <(list_running_detailed | sort -t'|' -k4,4nr)
    if [ "${#names[@]}" -eq 0 ]; then
        echo "(nothing to $verb)"; sleep 1; return
    fi
    names+=("cancel")
    PS3=$'\n'"$verb which? "
    local pick
    select pick in "${names[@]}"; do
        [ -z "${pick:-}" ] && continue
        [ "$pick" = "cancel" ] && break
        "$callback" "$pick"
        break
    done
}

run_menu() {
    banner
    local -a labels=() actions=()
    local -A letter_map=()  # letter -> action index
    local -A running_map=()
    local -A running_info=()
    local n rname rpid rstate rstart

    while IFS='|' read -r rname rpid rstate rstart; do
        [ -z "$rname" ] && continue
        running_map["$rname"]=1
        running_info["$rname"]="$rstate|$rstart"
    done < <(list_running_detailed)

    local -a sorted_names=()
    while IFS='|' read -r _ n; do
        [ -z "$n" ] && continue
        sorted_names+=("$n")
    done < <(
        for n in "${!running_info[@]}"; do
            IFS='|' read -r _ start <<< "${running_info[$n]}"
            printf '%s|%s\n' "$start" "$n"
        done | sort -t'|' -k1,1nr
    )

    for n in "${sorted_names[@]}"; do
        IFS='|' read -r rstate rstart <<< "${running_info[$n]:-?|0}"
        local state_label
        case "$rstate" in
            A) state_label="attached" ;;
            D) state_label="detached" ;;
            X) state_label="dead — use [kill] to remove" ;;
            *) state_label="unknown" ;;
        esac
        local age_label=""
        [ "$rstart" -gt 0 ] && age_label=", $(time_ago "$rstart")"
        labels+=("[running] claude-$n  ($state_label$age_label)")
        actions+=("attach:$n")
    done

    labels+=("(s) [shell]   New plain terminal (claude-shell-N)")
    actions+=("shell"); letter_map[s]=$(( ${#actions[@]} - 1 ))

    labels+=("(n) [new]     Start in custom path...")
    actions+=("custom"); letter_map[n]=$(( ${#actions[@]} - 1 ))

    labels+=("(p) [pick]    Resume a session...")
    actions+=("pick_session"); letter_map[p]=$(( ${#actions[@]} - 1 ))

    if [ "${#running_map[@]}" -gt 0 ]; then
        labels+=("(r) [rename]  Rename a running session...")
        actions+=("rename_menu"); letter_map[r]=$(( ${#actions[@]} - 1 ))
    fi

    # No menu actions for kill — explicit cleanup is rare enough that the
    # shell-only path is fine. To kill a session:
    #   screen -S claude-X -X quit
    # Sessions are ephemeral; nothing to "forget."

    local i
    for ((i=0; i<${#labels[@]}; i++)); do
        printf '  %2d) %s\n' "$((i+1))" "${labels[$i]}"
    done

    local reply idx action
    while true; do
        printf '\n> '
        read -r reply || exit 0   # Ctrl-D exits the launcher
        [ -z "$reply" ] && continue

        if [[ "$reply" =~ ^[a-zA-Z]$ ]]; then
            local l="${reply,,}"
            if [ -z "${letter_map[$l]:-}" ]; then
                echo "no shortcut '$reply'"; continue
            fi
            idx="${letter_map[$l]}"
        elif [[ "$reply" =~ ^[0-9]+$ ]]; then
            idx=$(( reply - 1 ))
            if (( idx < 0 || idx >= ${#actions[@]} )); then
                echo "out of range"; continue
            fi
        else
            echo "enter a number or letter"; continue
        fi

        action="${actions[$idx]}"
        case "$action" in
            attach:*)       attach_session "${action#attach:}"; return ;;
            custom)         prompt_custom_path; return ;;
            shell)          local sname="claude-$(next_shell_name)"
                            set_title "$sname"
                            local rc; rc=$(generate_session_rc "$sname")
                            screen -c "$rc" -S "$sname"; return ;;
            pick_session)   pick_session_menu; return ;;
            rename_menu)    pick_running_menu rename rename_session; return ;;
        esac
    done
}

while true; do run_menu; done
