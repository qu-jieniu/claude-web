#!/bin/bash
# claude-discord-clear — delete recent messages from a Discord channel
# and optionally reset the router's context by restarting the service.
#
# DM channels: only bot-authored messages are deletable (Discord enforces this —
# no permission system in DMs, bots can only delete their own).
# Guild channels: if the bot has MANAGE_MESSAGES, all messages in the batch
# are deleted; otherwise falls back to bot-only.
# 403s are counted but don't abort — the script keeps going through the batch.
set -euo pipefail

CHANNEL=""
RESET=0
LIMIT=100
DRY_RUN=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --channel) CHANNEL="${2:-}"; shift 2 ;;
        --reset)   RESET=1; shift ;;
        --limit)   LIMIT="${2:-100}"; shift 2 ;;
        --dry-run) DRY_RUN=1; shift ;;
        -h|--help)
            cat <<EOF
usage: $0 [--channel <id>] [--reset] [--limit N=100] [--dry-run]

  --channel ID   Discord channel (or DM) ID to clear.
  --reset        Restart claude-discord.service (resets router context).
  --limit N      Messages to fetch (default 100, Discord API max per call).
  --dry-run      List what would be deleted without deleting.

In DMs: only the bot's own messages get deleted (Discord limitation).
In guild channels with MANAGE_MESSAGES: all fetched messages are deleted.
EOF
            exit 0 ;;
        *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
done

[ -n "$CHANNEL" ] || [ "$RESET" -eq 1 ] || { echo "need --channel and/or --reset" >&2; exit 1; }

if [ -n "$CHANNEL" ]; then
    TOKEN_FILE="$HOME/.claude/channels/discord/.env.bak"
    [ -r "$TOKEN_FILE" ] || { echo "missing $TOKEN_FILE" >&2; exit 1; }
    TOKEN=$(grep -E "^DISCORD_BOT_TOKEN=" "$TOKEN_FILE" | cut -d= -f2-)
    [ -n "$TOKEN" ] || { echo "DISCORD_BOT_TOKEN empty in $TOKEN_FILE" >&2; exit 1; }

    msgs_json=$(curl -sS -H "Authorization: Bot $TOKEN" \
        "https://discord.com/api/v10/channels/$CHANNEL/messages?limit=$LIMIT")

    mapfile -t entries < <(printf '%s' "$msgs_json" | python3 -c '
import json, sys
try: data = json.load(sys.stdin)
except Exception as e: print(f"parse error: {e}", file=sys.stderr); sys.exit(1)
if isinstance(data, dict) and data.get("message"):
    print(f"api error: {data.get('message')} (code {data.get('code')})", file=sys.stderr); sys.exit(1)
if not isinstance(data, list):
    print(f"unexpected response: {str(data)[:200]}", file=sys.stderr); sys.exit(1)
for m in data:
    mid = m.get("id", "")
    aid = m.get("author", {}).get("id", "")
    preview = (m.get("content", "") or "")[:40].replace("\n", " ").replace("|", "_")
    print(f"{mid}|{aid}|{preview}")
')

    total="${#entries[@]}"
    echo "fetched $total messages from channel $CHANNEL"

    # Delete one message with up to 5 retries on 429. Honors Discord's
    # `retry_after` header on rate-limit responses instead of a flat sleep.
    # Returns: "ok" | "skip" | "fail:<http>"
    delete_one() {
        local mid="$1" attempt=0 http retry body
        body=$(mktemp); trap "rm -f $body" RETURN
        while :; do
            http=$(curl -sS -o "$body" -w "%{http_code}" -X DELETE \
                -H "Authorization: Bot $TOKEN" \
                "https://discord.com/api/v10/channels/$CHANNEL/messages/$mid")
            case "$http" in
                200|204) echo ok; return ;;
                403)     echo skip; return ;;  # DM + not our message
                429)
                    attempt=$((attempt + 1))
                    if [ "$attempt" -gt 5 ]; then echo "fail:429"; return; fi
                    retry=$(python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get("retry_after", 1.0))
except Exception: print(1.0)' "$body" 2>/dev/null || echo 1.0)
                    # Pad slightly to avoid re-hitting the limit right at reset
                    sleep "$(python3 -c "print(float('$retry') + 0.2)")"
                    ;;
                *) echo "fail:$http"; return ;;
            esac
        done
    }

    deleted=0; skipped=0; failed=0
    for e in "${entries[@]}"; do
        IFS='|' read -r mid aid preview <<< "$e"
        [ -z "$mid" ] && continue
        if [ "$DRY_RUN" -eq 1 ]; then
            printf '  [dry] %s  author=%s  %s\n' "$mid" "$aid" "$preview"
            continue
        fi
        result=$(delete_one "$mid")
        case "$result" in
            ok)     deleted=$((deleted + 1)) ;;
            skip)   skipped=$((skipped + 1)) ;;
            fail:*) failed=$((failed + 1)); echo "  $mid: HTTP ${result#fail:}" ;;
        esac
        sleep 0.3  # base spacing between deletes
    done
    if [ "$DRY_RUN" -eq 0 ]; then
        echo "deleted=$deleted  skipped=$skipped (not ours)  failed=$failed"
    fi
fi

if [ "$RESET" -eq 1 ]; then
    echo "triggering router restart (detached)..."
    # Detach via systemd-run so the restart survives this script being killed
    # when systemd stops the service we're running inside of.
    systemd-run --user --no-block --collect \
        systemctl --user restart claude-discord.service
fi
