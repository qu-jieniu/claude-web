#!/usr/bin/env python3
"""Run the HTTP front and terminal transport as one supervised appliance."""
import argparse
import os
from pathlib import Path
import signal
import subprocess
import sys
import time


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--root', default=os.environ.get('OMP_WEB_ROOT', '/opt/omp-web'))
    parser.add_argument('--http-port', type=int, default=os.environ.get('OMP_HTTP_PORT', '8080'))
    parser.add_argument('--terminal-port', type=int, default=os.environ.get('OMP_TERMINAL_PORT', '7682'))
    parser.add_argument('--composer-port', type=int, default=os.environ.get('OMP_COMPOSER_PORT', '7683'))
    parser.add_argument('--bind', choices=('127.0.0.1', '0.0.0.0'),
                        default=os.environ.get('OMP_BIND_ADDRESS', '127.0.0.1'))
    args = parser.parse_args()
    for port in (args.http_port, args.terminal_port, args.composer_port):
        if not 1 <= port <= 65535:
            parser.error('ports must be between 1 and 65535')
    root = Path(args.root).resolve()
    if not (root / 'web/vendor/xterm.js').is_file():
        parser.error('browser assets missing; run npm ci && npm run build in the application root')
    # Browser PTYs are independent clients, even when this service starts in tmux.
    os.environ.pop('TMUX', None)
    os.environ.pop('TMUX_PANE', None)
    os.environ.update({
        'OMP_WEB_ROOT': str(root),
        'OMP_HTTP_PORT': str(args.http_port),
        'OMP_TERMINAL_PORT': str(args.terminal_port),
        'OMP_COMPOSER_PORT': str(args.composer_port),
        'OMP_BIND_ADDRESS': args.bind,
        'LANG': 'C.UTF-8',
        'LC_ALL': 'C.UTF-8',
        'PATH': f'{root}:' + os.environ.get('PATH', '/usr/local/bin:/usr/bin:/bin'),
    })
    stopping = False

    def stop(_signum, _frame):
        nonlocal stopping
        stopping = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    children = []
    result = 0
    try:
        children.append(subprocess.Popen([
            sys.executable, str(root / 'omp-web-composer'), '--port', str(args.composer_port),
        ], start_new_session=True))
        children.append(subprocess.Popen([
            'ttyd', '-i', args.bind, '-p', str(args.terminal_port),
            '-W', '-O', '-a', '-b', '/t', '-T', 'xterm-256color',
            str(root / 'omp-web-launch'),
        ], start_new_session=True))
        children.append(subprocess.Popen([
            'caddy', 'run', '--config', str(root / 'Caddyfile'), '--adapter', 'caddyfile',
        ], start_new_session=True))
        while not stopping:
            for child in children:
                code = child.poll()
                if code is not None:
                    print(f'omp-web: {child.args[0]} exited ({code}); stopping appliance', file=sys.stderr)
                    result = 1
                    stopping = True
                    break
            if not stopping:
                time.sleep(0.1)
    except OSError as error:
        print(f'omp-web: {error}', file=sys.stderr)
        result = 1
    finally:
        for child in children:
            if child.poll() is None:
                try:
                    os.killpg(child.pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
        deadline = time.monotonic() + 5
        for child in children:
            try:
                child.wait(timeout=max(0, deadline - time.monotonic()))
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(child.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                child.wait()
    return result


if __name__ == '__main__':
    sys.exit(main())
