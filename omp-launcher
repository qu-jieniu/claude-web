#!/bin/bash
# Interactive session picker for omp. Used as ttyd's entry point (the omp-web
# quadlet → omp-web.service) and as the local `omp-attach` function. Every
# session is a WINDOW in the host tmux (session "1") — created, listed and
# attached through the tmux socket reachable from the container. GNU screen
# remains in the image only as the portable-appliance fallback for machines
# without a host tmux; the launcher no longer creates screen sessions.
set -uo pipefail

PROJECTS_DIR="$HOME/.omp/agent/sessions"

sanitize() { printf '%s' "$1" | tr -c 'a-zA-Z0-9_-' '_' | tr -s '_'; }

# Emit an OSC 0 escape to set the terminal/browser-tab title. ttyd reflects
# this in the page <title>.
set_title() { printf '\033]0;%s\007' "$1"; }

# tmux attach runs under TERM=ttyd-256m (see ttyd-256m.src): tmux enables and
# parses mouse only when the client terminfo has kmous, and the default
# ttyd-256color strips it (kept for the legacy screen fallback paths).
tmux_attach() {
    if [[ "${TERM:-}" == ttyd-* ]]; then
        TERM=ttyd-256m tmux attach "$@"
    else
        tmux attach "$@"
    fi
}

# Unique window-name suffix within session 1: <base>, <base>-2, <base>-3, …
next_win_name() {
    local base="${1:-shell}"
    local i=1 name="$base"
    while tmux list-windows -t =1 -F '#{window_name}' 2>/dev/null | LC_ALL=C grep -Fxq -- "$name"; do
        i=$((i+1)); name="$base-$i"
    done
    printf '%s' "$name"
}

# Launch omp as a NEW WINDOW in host tmux session "1" (created if absent) and
# select it. $1 = window name, $2 = cwd, remaining arguments go to omp.
# Pass argv directly to tmux: paths and session IDs must never become shell
# source. The login shell changes directory explicitly after startup files.
launch_omp_window() {
    local name="$1" cwd="$2" wid
    shift 2
    name=$(next_win_name "$name")
    set_title "omp-$name"
    if tmux has-session -t =1 2>/dev/null; then
        wid=$(tmux new-window -P -F '#{window_id}' -t =1: -n "$name" -c "$cwd" \
            bash -lc 'cd -- "$1" || exit; shift; omp --allow-home "$@"; exec bash' omp-web "$cwd" "$@") \
            || { echo "tmux new-window failed"; sleep 1; return 1; }
    else
        wid=$(tmux new-session -d -P -F '#{window_id}' -s 1 -n "$name" -c "$cwd" \
            bash -lc 'cd -- "$1" || exit; shift; omp --allow-home "$@"; exec bash' omp-web "$cwd" "$@") \
            || { echo "tmux new-session failed"; sleep 1; return 1; }
    fi
    tmux_attach -t "$wid"
}

short_name_for() {
    local path="$1" base
    if [ "$path" = "$HOME" ]; then echo "home"; return; fi
    base=$(sanitize "$(basename "$path")")
    # Avoid double-prefix (omp-omp-web) when the basename already carries a
    # launcher prefix; claude- covers pre-rename dirs like ~/.containers/omp-web.
    base="${base#omp-}"
    base="${base#claude-}"
    [ -z "$base" ] && base="session"
    printf '%s' "$base"
}

time_ago() {
    local now diff
    now=$(date +%s); diff=$(( now - $1 ))
    if   (( diff < 60 ));    then echo "${diff}s ago"
    elif (( diff < 3600 ));  then echo "$((diff/60))m ago"
    elif (( diff < 86400 )); then echo "$((diff/3600))h ago"
    else echo "$((diff/86400))d ago"
    fi
}

# Keep labels within the actual viewport, including wide Unicode characters.
fit_label() {
    python3 - "${COLUMNS:-80}" "${2:-6}" "$1" <<'PY'
import sys, unicodedata
cols, margin, text = sys.argv[1:]
limit = max(1, int(cols) - int(margin))
text = ''.join(c if not unicodedata.category(c).startswith('C') else ' ' for c in text)
def width(c):
    return 0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in ('W', 'F') else 1
if sum(map(width, text)) > limit:
    out, used = [], 0
    for c in text:
        if used + width(c) > limit - 1:
            break
        out.append(c)
        used += width(c)
    text = ''.join(out) + '…'
print(text, end='')
PY
}

extract_cwd() {
    python3 - "$1" <<'PY' 2>/dev/null
import json, sys
try:
    with open(sys.argv[1]) as fp:
        for line in fp:
            line = line.strip()
            if not line: continue
            try: d = json.loads(line)
            except Exception: continue
            if isinstance(d, dict) and isinstance(d.get('cwd'), str):
                print(d['cwd']); break
except Exception:
    pass
PY
}

extract_first_user_msg() {
    python3 - "$1" <<'PY' 2>/dev/null
import json, sys
def flat(c):
    if isinstance(c, str): return c
    if isinstance(c, list):
        parts = []
        for x in c:
            if isinstance(x, dict) and x.get('type') == 'text':
                parts.append(x.get('text', ''))
        return ' '.join(parts)
    return ''
try:
    with open(sys.argv[1]) as fp:
        for line in fp:
            line = line.strip()
            if not line: continue
            try: d = json.loads(line)
            except Exception: continue
            if d.get('type') == 'message':
                msg = d.get('message', {})
                if isinstance(msg, dict) and msg.get('role') == 'user':
                    text = flat(msg.get('content', ''))
                    text = ' '.join(text.split())  # collapse whitespace
                    if text:
                        print(text[:100]); break
except Exception:
    pass
PY
}

list_projects() {
    # Single Python pass over all project dirs — replaces what used to be
    # 39× per-project Python subprocesses (one per `extract_cwd` call) that
    # together took ~3.7s on a real workload. The hot loop is reading the
    # first non-empty line of the newest JSONL in each dir, so it's the
    # subprocess-startup cost that dominated, not the actual work.
    python3 - "$PROJECTS_DIR" "$HOME" <<'PY'
import json, os, re, sys
projects_dir, home = sys.argv[1], sys.argv[2]

def sanitize(s):
    return re.sub(r'_+', '_', re.sub(r'[^a-zA-Z0-9_-]', '_', s))

def short_name(cwd):
    if cwd == home: return 'home'
    base = sanitize(os.path.basename(cwd))
    for pfx in ('omp-', 'claude-'):
        if base.startswith(pfx):
            base = base[len(pfx):]
            break
    return base or 'session'

def newest_jsonl(pdir):
    best = None
    best_m = -1
    try:
        for f in os.listdir(pdir):
            if not f.endswith('.jsonl'): continue
            p = f"{pdir}/{f}"
            try: m = os.path.getmtime(p)
            except OSError: continue
            if m > best_m:
                best_m, best = m, p
    except OSError:
        pass
    return best, best_m

def extract_cwd(path):
    try:
        with open(path) as fp:
            for line in fp:
                line = line.strip()
                if not line: continue
                try: d = json.loads(line)
                except Exception: continue
                if isinstance(d, dict) and isinstance(d.get('cwd'), str):
                    return d['cwd']
    except Exception:
        pass
    return None

rows = []
try:
    entries = os.listdir(projects_dir)
except OSError:
    sys.exit(0)
for entry in entries:
    pdir = f"{projects_dir}/{entry}"
    if not os.path.isdir(pdir): continue
    newest, mtime = newest_jsonl(pdir)
    if newest is None: continue
    cwd = extract_cwd(newest)
    if not cwd or not os.path.isdir(cwd): continue
    rows.append((short_name(cwd), cwd, int(mtime), pdir))

rows.sort(key=lambda r: -r[2])
for r in rows:
    print('|'.join(str(x) for x in r))
PY
}

list_sessions_in() {
    # Sessions in a project dir, sorted newest-first.
    # Output: uuid|mtime|preview
    #
    # Single Python pass over all JSONLs in the dir. Preview prefers the
    # auto-generated session title (last title/title_change wins), falling
    # back to the first user message.
    python3 - "$1" <<'PY'
import json, os, sys
pdir = sys.argv[1]

def preview(path):
    title = ''
    first = ''
    try:
        with open(path) as fp:
            for line in fp:
                line = line.strip()
                if not line: continue
                try: d = json.loads(line)
                except Exception: continue
                if not isinstance(d, dict): continue
                t = d.get('type')
                if t in ('title', 'title_change') and d.get('title'):
                    title = str(d['title'])
                elif t == 'message' and not first:
                    msg = d.get('message', {})
                    if isinstance(msg, dict) and msg.get('role') == 'user':
                        c = msg.get('content', '')
                        if isinstance(c, str):
                            first = c
                        elif isinstance(c, list):
                            first = ' '.join(
                                x.get('text', '') for x in c
                                if isinstance(x, dict) and x.get('type') == 'text')
    except Exception:
        pass
    text = title.strip() or ' '.join(first.split())
    return ' '.join(text.split())[:100] or '(no user messages)'

rows = []
try:
    entries = os.listdir(pdir)
except OSError:
    sys.exit(0)
for f in entries:
    if not f.endswith('.jsonl') or '_' not in f: continue
    path = f"{pdir}/{f}"
    try:
        mtime = int(os.path.getmtime(path))
    except OSError:
        continue
    uuid = f.rsplit('_', 1)[1][:-len('.jsonl')]
    rows.append((uuid, mtime, preview(path)))

rows.sort(key=lambda r: -r[1])
for uuid, mtime, pv in rows:
    print(f'{uuid}|{mtime}|{pv}')
PY
}

banner() {
    local size
    size=$(stty size 2>/dev/null) || size=""
    [[ "$size" =~ ^[0-9]+\ ([0-9]+)$ ]] && (( BASH_REMATCH[1] > 0 )) && COLUMNS=${BASH_REMATCH[1]}
    [[ "${COLUMNS:-}" =~ ^[1-9][0-9]*$ ]] || COLUMNS=80
    clear
    set_title "omp-launcher"
    printf '\n  %s\n' "$(fit_label 'omp — session launcher' 2)"
    printf '  %s\n\n' "$(date '+%F %H:%M')"
    local hint
    for hint in 'Ctrl-a d: detach' 'Ctrl-a [: scroll / search' 'Ctrl-a j: transcript' 'Ctrl-a n/p: switch windows'; do
        printf '  %s\n' "$(fit_label "$hint" 2)"
    done
    printf '\n'
}

# Unlike bash select, always use one column, even after a viewport resize.
# The selected zero-based index is returned in REPLY.
choose_item() {
    local prompt="$1" i=0 choice
    shift
    for choice in "$@"; do
        ((i+=1))
        printf '  %2d) %s\n' "$i" "$(fit_label "$choice")"
    done
    while read -erp "$prompt: " choice; do
        if [[ "$choice" =~ ^[0-9]{1,6}$ ]] && (( 10#$choice >= 1 && 10#$choice <= $# )); then
            REPLY=$((10#$choice - 1))
            return
        fi
        printf 'Choose 1–%d, or Ctrl-D to return.\n' "$#"
    done
    return 1
}

resume_specific_session() {
    # Resume an omp session as a window in host tmux session "1".
    # Reuse a pane whose launch command already identifies this session UUID.
    #   1. uuid already live in a window  → select that window
    #   2. project window exists but dead → resume INTO it (id stays stable)
    #   3. otherwise                      → new window (name auto-deduped)
    local name="$1" cwd="$2" uuid="$3"
    local short="${uuid:0:8}"

    # 1) already running somewhere?
    local wid
    wid=$(tmux list-panes -a -F '#{window_id}|#{pane_id}|#{pane_dead}|#{pane_start_command}' 2>/dev/null \
        | while IFS='|' read -r w pane dead cmd; do
            if [[ "$cmd" == *"$uuid"* ]]; then
                echo "$w|$pane|$dead"
                break
            fi
          done)
    if [ -n "$wid" ]; then
        local w pane dead
        IFS='|' read -r w pane dead <<< "$wid"
        if [ "$dead" = "1" ]; then
            tmux respawn-pane -t "$pane" -c "$cwd" \
                bash -lc 'cd -- "$1" || exit; shift; omp --allow-home "$@"; exec bash' omp-web "$cwd" --resume "$uuid" || return 1
        fi
        tmux select-window -t "$w"
        tmux select-pane -t "$pane"
        tmux_attach -t "$w"
        return
    fi

    local default="${name}-${short}"
    local n
    n=$(prompt_screen_name "$default") || { echo "invalid name"; sleep 1; return 1; }

    # 2) project window dead → reuse it (same name/cwd, keep the id)
    local proj_wid
    proj_wid=$(tmux list-windows -t '=1' -F '#{window_name}|#{window_id}|#{pane_dead}|#{pane_current_path}' 2>/dev/null \
        | while IFS='|' read -r wn w pdead ppath; do
            [ "$wn" = "$n" ] && [ "$pdead" = "1" ] && echo "$w"
          done | head -1)
    if [ -n "$proj_wid" ]; then
        local flags; flags=$(prompt_auto_approve) || return 1
        tmux respawn-pane -t "$proj_wid" -c "$cwd" \
            bash -lc 'cd -- "$1" || exit; shift; omp --allow-home "$@"; exec bash' omp-web "$cwd" --resume "$uuid" ${flags:+"$flags"} || return 1
        tmux select-window -t "$proj_wid"
        tmux_attach -t "$proj_wid"
        return
    fi

    # 3) new window — launch_omp_window deduplicates the name.
    local flags; flags=$(prompt_auto_approve) || return 1
    launch_omp_window "$n" "$cwd" --resume "$uuid" ${flags:+"$flags"}
}

pick_by_uuid() {
    local input full_uuid matches=()
    read -erp "UUID (full or 8+ char prefix): " input || return
    input="${input,,}"
    [[ "$input" =~ ^[0-9a-f-]{8,36}$ ]] || { echo "need a UUID or 8+ char prefix"; sleep 1; return; }

    # Find matching jsonl files under any project dir. omp session files are
    # <timestamp>_<uuid>.jsonl, so anchor on the underscore before the UUID.
    local f
    for f in "$PROJECTS_DIR"/*/*_"$input"*.jsonl; do
        [ -f "$f" ] && matches+=("$f")
    done

    if [ "${#matches[@]}" -eq 0 ]; then
        echo "No session matching $input"; sleep 2; return
    fi
    if [ "${#matches[@]}" -gt 1 ]; then
        echo "Ambiguous — matches:"
        printf '  %s\n' "${matches[@]}"
        sleep 3; return
    fi
    local f="${matches[0]}"
    full_uuid="${f##*/}"
    full_uuid="${full_uuid%.jsonl}"
    full_uuid="${full_uuid##*_}"
    local cwd; cwd=$(extract_cwd "$f")
    if [ -z "$cwd" ] || [ ! -d "$cwd" ]; then
        echo "cwd not found or stale for $full_uuid"; sleep 2; return
    fi
    local sel_name; sel_name=$(short_name_for "$cwd")
    echo "Found: $full_uuid  cwd=$cwd"
    resume_specific_session "$sel_name" "$cwd" "$full_uuid"
}

pick_session_menu() {
    banner
    echo "Choose project or UUID:"
    echo
    local -a plabels=() pcwds=() pdirs=() pnames=()
    local name cwd mtime pdir
    while IFS='|' read -r name cwd mtime pdir; do
        [ -z "$name" ] && continue
        plabels+=("$name  —  $cwd  ($(time_ago "$mtime"))")
        pcwds+=("$cwd")
        pdirs+=("$pdir")
        pnames+=("$name")
    done < <(list_projects)
    plabels+=("[id] Type UUID directly...")
    plabels+=("cancel")

    choose_item project "${plabels[@]}" || return
    local idx=$REPLY
    (( idx == ${#pcwds[@]} + 1 )) && return
    if (( idx == ${#pcwds[@]} )); then
        pick_by_uuid
        return
    fi
    local sel_name="${pnames[$idx]}"
    local sel_cwd="${pcwds[$idx]}"
    local sel_pdir="${pdirs[$idx]}"

    printf '\n%s\n\n' "$(fit_label "Sessions: $sel_name" 0)"
    local -a slabels=() suuids=()
    local uuid stime preview
    while IFS='|' read -r uuid stime preview; do
        [ -z "$uuid" ] && continue
        slabels+=("${uuid:0:8}  ($(time_ago "$stime"))  ${preview:0:70}")
        suuids+=("$uuid")
    done < <(list_sessions_in "$sel_pdir")
    if [ "${#suuids[@]}" -eq 0 ]; then
        echo "(no sessions found)"; sleep 1; return
    fi
    slabels+=("cancel")
    choose_item session "${slabels[@]}" || return
    (( REPLY == ${#suuids[@]} )) && return
    resume_specific_session "$sel_name" "$sel_cwd" "${suuids[$REPLY]}"
}

prompt_screen_name() {
    # $1 = default (without omp- prefix). Prints chosen name on stdout (also without prefix).
    local default="$1" input n
    read -erp "Window name [$default]: " input || return 1
    input="${input:-$default}"
    # Strip omp- so typing "omp-foo" doesn't become omp-omp-foo
    input="${input#omp-}"
    n=$(sanitize "$input")
    [ -z "$n" ] && { echo "" ; return 1; }
    printf '%s' "$n"
}

prompt_auto_approve() {
    local ans
    read -erp "Auto-approve tools? [y/N]: " ans || return 1
    case "${ans,,}" in
        y|yes) printf '%s' '--auto-approve' ;;
        *) printf '' ;;
    esac
}

prompt_custom_path() {
    local p default n ans
    read -erp "Path (Tab to complete): " p || return 1
    p="${p/#\~/$HOME}"
    [ -z "$p" ] && return 1
    if [ ! -e "$p" ]; then
        read -erp "Create path? [Y/n]: " ans || return 1
        case "${ans,,}" in
            n|no) echo "cancelled"; sleep 1; return 1 ;;
        esac
        mkdir -p -- "$p" || { echo "mkdir failed"; sleep 1; return 1; }
    fi
    p=$(realpath -e -- "$p" 2>/dev/null) || { echo "invalid path"; sleep 1; return 1; }
    [ -d "$p" ] || { echo "not a directory"; sleep 1; return 1; }
    default=$(short_name_for "$p")
    n=$(prompt_screen_name "$default") || { echo "invalid name"; sleep 1; return 1; }
    local flags; flags=$(prompt_auto_approve) || return 1
    launch_omp_window "$n" "$p" ${flags:+"$flags"}
}

# Both historical new-session shortcuts use the same safe launch flow.
new_tmux_window() { prompt_custom_path; }

run_menu() {
    banner
    local -a labels=() actions=()
    local -A letter_map=()  # letter -> action index

    # Live host-tmux windows first — the user's omp tabs live in tmux on the
    # host. Enumerate every window across all tmux sessions and target by the
    # unique window ID (@N) so index shifts/renames can't break the action.
    if command -v tmux >/dev/null 2>&1 && tmux list-windows -a >/dev/null 2>&1; then
        local prev_sess=""
        while IFS='|' read -r sess widx wname wactive wpath wwid; do
            [ -z "$sess" ] && continue
            # blank line between window groups (per tmux session)
            if [ -n "$prev_sess" ] && [ "$sess" != "$prev_sess" ]; then
                labels+=(""); actions+=("")
            fi
            prev_sess="$sess"
            local tstar=""
            [ "$wactive" = "1" ] && tstar="*"
            labels+=("[tmux $sess:$widx] $wname$tstar  —  $wpath")
            actions+=("tattach:$wwid")
        done < <(tmux list-windows -a -F '#{session_name}|#{window_index}|#{window_name}|#{window_active}|#{pane_current_path}|#{window_id}' 2>/dev/null)
    fi

    # blank line between the entry groups and the letter shortcuts
    [ ${#labels[@]} -gt 0 ] && [ -n "${actions[${#actions[@]}-1]}" ] && { labels+=(""); actions+=(""); }

    labels+=("(s) New shell")
    actions+=("shell"); letter_map[s]=$(( ${#actions[@]} - 1 ))

    labels+=("(t) Attach tmux")
    actions+=("tmux"); letter_map[t]=$(( ${#actions[@]} - 1 ))

    labels+=("(w) New omp window")
    actions+=("newtmux"); letter_map[w]=$(( ${#actions[@]} - 1 ))

    labels+=("(n) New in custom path")
    actions+=("custom"); letter_map[n]=$(( ${#actions[@]} - 1 ))

    labels+=("(p) Resume session")
    actions+=("pick_session"); letter_map[p]=$(( ${#actions[@]} - 1 ))

    local i shown=0
    local -a num_map=()   # displayed number -> actions index (separators skipped)
    for ((i=0; i<${#labels[@]}; i++)); do
        # empty action = visual group separator, printed without a number
        if [ -z "${actions[$i]}" ]; then
            printf '\n'
        else
            shown=$((shown + 1))
            num_map[shown]=$i
            printf '  %2d) %s\n' "$shown" "$(fit_label "${labels[$i]}")"
        fi
    done

    local reply idx action
    while true; do
        printf '\n> '
        read -r reply || exit 0   # Ctrl-D exits the launcher
        [ -z "$reply" ] && continue

        if [[ "$reply" =~ ^[a-zA-Z]$ ]]; then
            local l="${reply,,}"
            if [ -z "${letter_map[$l]:-}" ]; then
                echo "no shortcut '$reply'"; continue
            fi
            idx="${letter_map[$l]}"
        elif [[ "$reply" =~ ^[0-9]{1,6}$ ]]; then
            idx="${num_map[$((10#$reply))]:-}"
            if [ -z "$idx" ]; then
                echo "out of range" ; continue
            fi
        else
            echo "enter a number or letter"; continue
        fi

        action="${actions[$idx]}"
        case "$action" in
            custom)         prompt_custom_path; return ;;
            tmux)           # Raw attach: most-recent session; Ctrl-a s lists all.
                            tmux_attach 2>/dev/null || echo "no host tmux server reachable"
                            return ;;
            tattach:*)      tmux_attach -t "${action#tattach:}" 2>/dev/null \
                                || echo "tmux window gone"
                            return ;;
            newtmux)        new_tmux_window; return ;;
            shell)          # Plain host shell as a tmux window — every tmux
                            # pane runs on the host, so no bridge is needed.
                            local n wid; n=$(next_win_name shell)
                            set_title "omp-$n"
                            if tmux has-session -t =1 2>/dev/null; then
                                wid=$(tmux new-window -P -F '#{window_id}' -t =1: -n "$n" -c "$HOME" bash -l) || return 1
                            else
                                wid=$(tmux new-session -d -P -F '#{window_id}' -s 1 -n "$n" -c "$HOME" bash -l) || return 1
                            fi
                            tmux_attach -t "$wid"
                            return ;;
            pick_session)   pick_session_menu; return ;;
        esac
    done
}

# Direct-attach from URL: ttyd (-a) passes ?arg=<value> as $1. tmux-<N> names
# a host tmux window by unique ID (@N) — reopened/bookmarked tabs (and the
# wrapper page's per-session URL) land straight in it. A bogus arg can't spawn
# a session or run anything — it just falls through to the normal menu. On
# detach, tmux_attach returns and the loop below shows the menu, so the tab
# stays useful.
if [ -n "${1:-}" ]; then
    suffix="${1#omp-}"
    if [ "$suffix" = "tmux" ]; then
        # ?arg=tmux — straight into the host tmux (its own session/window
        # bar provides the cycling UX).
        set_title "omp-tmux"
        tmux_attach 2>/dev/null || echo "no host tmux server reachable"
    elif [[ "$suffix" =~ ^tmux-([0-9]+)$ ]]; then
        # ?arg=tmux-<N> — attach one host tmux window by unique ID (@N).
        set_title "omp-tmux-${BASH_REMATCH[1]}"
        tmux_attach -t "@${BASH_REMATCH[1]}" 2>/dev/null \
            || echo "tmux window gone"
    fi
fi

while true; do run_menu; done
